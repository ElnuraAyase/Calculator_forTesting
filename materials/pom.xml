  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>GVRT-API-Tests</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <version>2.20.1</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>
            -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
          </argLine>
          <printSummary>true</printSummary>
          <properties>
            <property>
              <name>suitethreadpoolsize</name>
              <value>${threadCount}</value>
            </property>
<!--            <property>-->
<!--              <name>testnames</name>-->
<!--              <value>${suiteNames}</value>-->
<!--            </property>-->
          </properties>
          <skip>false</skip>
          <suiteXmlFiles>
            <suiteXmlFile>${fileName}</suiteXmlFile>
          </suiteXmlFiles>
          <systemProperties>
            <allure.results.directory>target/allure-results</allure.results.directory>
            <property>
              <name>allure.link.tms.pattern</name>
              <value>https://..../_workitems/edit/{}</value>
            </property>
            <property>
              <name>allure.link.mylink.pattern</name>
              <value>https://..../_workitems/edit/{}</value>
            </property>
          </systemProperties>
          <systemPropertyVariables>
            <allure.results.directory>target/allure-results</allure.results.directory>
            <clean>${def.clean}</clean>
            <perf.data>${dataFile}</perf.data>
            <test.env>${env.name}</test.env>
          </systemPropertyVariables>
        </configuration>
        <dependencies>
          <dependency>
            <artifactId>aspectjweaver</artifactId>
            <groupId>org.aspectj</groupId>
            <version>${aspectj.version}</version>
          </dependency>
        </dependencies>
        <groupId>org.apache.maven.plugins</groupId>
        <version>${maven.surefire.version}</version>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>11</source>
          <target>11</target>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.8.0</version>
      </plugin>
      <plugin>
        <artifactId>allure-maven</artifactId>
        <configuration>
          <outputDirectory>${basedir}/target/allure-reports/</outputDirectory>
          <!--<reportDirectory>${basedir}/target/allure-results</reportDirectory>-->
        </configuration>
        <groupId>io.qameta.allure</groupId>
        <version>2.10.0</version>
      </plugin>
      <!-- display active profile in compile phase -->
      <plugin>
        <artifactId>maven-help-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>active-profiles</goal>
            </goals>
            <id>show-profiles</id>
            <phase>compile</phase>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.1.0</version>
      </plugin>
      <!-- performance plugin -->
      <plugin>
        <groupId>io.gatling</groupId>
        <artifactId>gatling-maven-plugin</artifactId>
        <version>4.5.0</version>
        <executions>
          <execution>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <simulationClass>gatling.${simulationName}</simulationClass>
          <noReports>false</noReports>
          <jvmArgs>
            <jvmArg>-Dfile=${dataFile}</jvmArg>
            <jvmArg>-Dusers=${usersCount}</jvmArg>
          </jvmArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
